msgstr "Herkenbare illustratie, strip, 3D-afbeelding, abstracte achtergrond"

#: src/admin/Knowledge.js:49
msgid "Real photo, only color, light, noise or crop with an AI tool"
msgstr "Echte foto, alleen kleur, licht, ruis of bijsnijden met een AI-tool"

#: src/admin/Knowledge.js:57
msgid "Camera or stock photo without AI"
msgstr "Camera- of stockfoto zonder AI"

